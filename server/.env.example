# Required: Anthropic API key used for AI-assisted PDF parsing.
# Create one at https://console.anthropic.com. Never commit the real value —
# this file is a template only.
ANTHROPIC_API_KEY=

# The deployed frontend's origin, for CORS (e.g. https://simpleset.netlify.app).
# Leave unset in local dev to allow any origin.
ALLOWED_ORIGIN=

# Optional: port to listen on (default 8787).
PORT=

# Optional: free AI parses per device per day before rate-limiting kicks in (default 10).
FREE_PARSES_PER_DAY=
